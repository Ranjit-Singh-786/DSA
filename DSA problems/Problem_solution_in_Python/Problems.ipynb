    "#  arr = [0,1,0,3,0,12]   <-- INPUT \n",
    "#  arr = [1,3,12,0,0,0]   <-- INPUT \n",
    "\n",
    "#SOLVING USING 2 POINTER (SLOW & FAST)\n",
    "arr = [0,1,0,3,0,12] \n",
    "slow = 0 \n",
    "for fast in range(len(arr)):\n",
    "    if arr[fast] != 0:\n",
    "        arr[slow],arr[fast] = arr[fast] , arr[slow]\n",
    "        slow += 1  \n",
    "print(arr)    "
   ]
  }
